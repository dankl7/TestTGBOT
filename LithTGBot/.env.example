# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=window_of_light
DB_USER=wol_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Encryption (AES-256 key for MAX auth tokens)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Admin (Telegram user IDs через запятую)
ADMIN_USER_IDS=123456789,987654321

# Proxy (optional; пустые значения = без прокси)
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASS=
TELEGRAM_PROXY_TYPE=HTTP

# VPN (gluetun)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wg_private_key
WIREGUARD_ADDRESSES=10.0.0.2/32
VPN_ENDPOINT_IP=your_vpn_endpoint_ip
VPN_ENDPOINT_PORT=51820
