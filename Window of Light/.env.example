# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=window_of_light
DB_USER=wol_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
CACHE_TTL=300
CACHE_TTL_PRODUCT=60

# Telegram API
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# Proxy (optional)
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASS=
TELEGRAM_PROXY_TYPE=HTTP

# Window of Light API (for LithTGBot)
WOL_API_BASE_URL=http://localhost:8000
WOL_API_TIMEOUT_SECONDS=10
